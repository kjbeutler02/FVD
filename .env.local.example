# --- Auth.js / Microsoft Entra ID ------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=

AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Single-tenant: replace <tenant-id>; multi-tenant: use "common" or "organizations"
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# --- Filevine API ------------------------------------------------------------
FILEVINE_PAT=
FILEVINE_CLIENT_ID=
FILEVINE_CLIENT_SECRET=

# Signs the short-lived internal Filevine session JWT (openssl rand -base64 32)
SESSION_SECRET=
